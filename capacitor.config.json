{
  "appId": "app.kunthai.mobile",
  "appName": "KunThai",
  "webDir": "dist",
  "android": {
    "useLegacyBridge": true
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DEFAULT",
      "hidden": false,
      "animation": "NONE"
    },
    "PushNotifications": {
      "presentationOptions": ["badge"]
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true,
      "autoBackdropColor": "auto"
    }
  }
}
