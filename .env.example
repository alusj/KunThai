# Browser-safe Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only payment configuration (never prefix these with VITE_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
# Existing deployments may use FLW_SECRET_KEY and FLW_SECRET_HASH instead.

# Monime (Orange Money mobile money). SUPABASE_SERVICE_ROLE_KEY above is also
# required for these to work — mobile money stays disabled without it.
MONIME_ACCESS_TOKEN=
MONIME_SPACE_ID=
# Optional: overrides the API base (defaults to https://api.monime.io/v1).
MONIME_API_URL=

PUBLIC_APP_URL=https://your-kunthai-domain.example
