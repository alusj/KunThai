# Browser-safe Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only payment configuration (never prefix these with VITE_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Monime (Orange Money mobile money). SUPABASE_SERVICE_ROLE_KEY above is also
# required for these to work — mobile money stays disabled without it.
MONIME_ACCESS_TOKEN=
MONIME_SPACE_ID=
# Optional: overrides the API base (defaults to https://api.monime.io/v1).
MONIME_API_URL=

PUBLIC_APP_URL=https://your-kunthai-domain.example

# KAI (Google Gemini). Server-only — never prefix with VITE_.
GEMINI_API_KEY=
# Optional switches. Defaults are in server/ai/aiConfig.js.
# KUNTHAI_AI_ENABLED=true
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# GEMINI_MODEL_STANDARD=gemini-3.5-flash
# GEMINI_MODEL_REASONING=gemini-3.5-flash
# AI_RATE_PER_MINUTE=10
# AI_RATE_PER_HOUR=80
# AI_RATE_PER_DAY=250
# AI_DAILY_COST_MICROS=400000
