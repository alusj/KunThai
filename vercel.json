{
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/moderate-post.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/admin-publish-scheduled",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/process-business-subscriptions",
      "schedule": "15 0 * * *"
    }
  ]
}
